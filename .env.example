INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Legacy option for the older post analyzer. The public Reel CLI does not
# require browser cookies or an Instagram login.
TREND_ANALYSIS_COOKIES_FILE=

# One of: openai (implemented), claude, ollama (not implemented yet).
TREND_MODEL_PROVIDER=openai

# Required only if TREND_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
# Optional override; defaults to gpt-5.6-terra if unset.
OPENAI_TREND_MODEL=
