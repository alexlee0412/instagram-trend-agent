INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Optional — trend_analysis engine only, unrelated to the Playwright collector above.
# Path to a Netscape-format cookie file, only needed for restricted Reels.
# Generate one with: python export_instagram_cookies.py
TREND_ANALYSIS_COOKIES_FILE=

# One of: openai (implemented), claude, ollama (not implemented yet). Leave blank to disable.
TREND_MODEL_PROVIDER=

# Required only if TREND_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
# Optional override; defaults to gpt-5.6-terra if unset.
OPENAI_TREND_MODEL=
